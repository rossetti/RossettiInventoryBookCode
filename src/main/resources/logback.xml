<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quiet the library's DEBUG chatter so an example's own output is the only thing
  a student sees on the console. Raise the root level to DEBUG when you need to
  see what the KSL is doing internally.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
